  "general_images_allowed": false,
  "reference_material_is_product_evidence": false,
  "review_max_calls": 3,
  "reference_limit": 2,
  "image_limit": 2,
  "image_review_enabled": false,
  "mutable_review_index": "usage-review.sqlite3",
  "failure_policy": "文字资料failed/in_progress不放行、不自动重试；uncertain/rejected复用为排除结果"
}
