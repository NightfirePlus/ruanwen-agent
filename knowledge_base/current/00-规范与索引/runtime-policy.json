{
  "contract_version": 1,
  "rules_version": "usage-review-1",
  "runtime_enabled": true,
  "strategy": "文字资料首次使用复核，按文件/元数据/来源/依赖/模型/提示词版本缓存；图片按登记归属直接使用",
  "snapshot_fact_verification_completed": false,
