# 密钥与本地配置,禁止提交
.env
*.key
secrets/
__pycache__/
*.pyc
# 赛题手册不随代码发布
*.pdf

# 知识库本地缓存(目录结构与资料正文),不提交
.cache/

# 本地联调用的临时提示词与素材,不提交
.local/
.vscode/
samples/web-*
samples/local-generation-check.*

# 只接受当前知识库；其他临时目录与运行时审核数据库不提交
knowledge_base/*
!knowledge_base/current/
knowledge_base/current/**/*.sqlite3
knowledge_base/current/**/*.sqlite3-*

# 用户确认后的作品库、宣传数据与门店长期记忆（运行时数据）
data/*.sqlite3
data/*.sqlite3-*
